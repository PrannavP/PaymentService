# Khalti Payment Service Configuration
KHALTI_LIVE_SECRET_KEY=your_khalti_live_secret_key
KHALTI_LIVE_PUBLIC_KEY=your_khalti_live_public_key
KHALTI_PAYMENT_DEV_URL=khalti_payment_dev_url
KHALTI_PAYMENT_PROD_URL=khalti_payment_prod_url

# Set this to true if you are running in production environment
IS_PRODUCTION=false

# database configs
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password